!docs/demos/
!docs/product/
docs/product/*
!docs/product/smoothing-proof-evidence.md

# Dotenv file
.env

# Node modules
node_modules/

# macOS metadata
.DS_Store

# Research notes (only claim-substantiating technical evidence ships)
research/*
